# Copy to .env and fill in. NEVER commit the real .env.
# The backend reads these via os.environ (see backend/config/settings.py).

# --- Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# --- Database ---
# Leave DB_ENGINE unset (or "sqlite") to use the bundled SQLite file for local
# dev. Set to "postgres" and fill the rest for the production target.
DB_ENGINE=sqlite
# DB_ENGINE=postgres
# DB_NAME=devforge
# DB_USER=devforge
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# --- Production-only (ignored when DJANGO_DEBUG=true) ---
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.devforge.example

# --- AI providers (Phase 6) — ENV ONLY, never hard-coded ---
# Which provider the gateway uses by default. "stub" (default) runs offline with
# no key; set "anthropic" for real completions and export ANTHROPIC_API_KEY.
AI_DEFAULT_PROVIDER=stub
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
